# Copy to .env and fill in. Never commit .env.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# From the app's webhook settings, once the app has a public HTTPS URL
PAYPAL_WEBHOOK_ID=

# Where clients open their Living Pay (your Render URL in production)
PUBLIC_URL=http://localhost:8790
CURRENCY_CODE=USD

# Claude (optional: turns on the AI layer)
ANTHROPIC_API_KEY=

# Required once this runs on the internet: the password for the owner's pages
LIVING_OWNER_PASSWORD=
# Optional: a separate password for judges, with a guided tour and limits
LIVING_JUDGE_PASSWORD=
# A PayPal sandbox Personal account for judges to pay with. Sandbox only, never a real login.
LIVING_DEMO_BUYER_EMAIL=
LIVING_DEMO_BUYER_PASSWORD=
